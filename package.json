{
  "name": "prep-kit-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AI Interview Prep Kit — backend API and generation pipeline",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "fixtures": "node fixtures/serve.mjs",
    "evaluate": "tsx scripts/evaluate.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "apify-client": "^2.25.0",
