    "cheerio": "^1.2.0",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "groq-sdk": "^1.6.0",
    "ipaddr.js": "^2.5.0",
    "mammoth": "^1.12.2",
    "mongoose": "^9.9.5",
    "multer": "^2.3.0",
    "robots-parser": "^3.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
